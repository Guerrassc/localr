# Copy to .env (never commit .env). Generate SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
GROQ_API_KEY=
UNSPLASH_ACCESS_KEY=

# Cookies are Secure by default (HTTPS only). For plain-http local dev only:
# SESSION_COOKIE_SECURE=0

# Set to 1 ONLY when running behind your own reverse proxy (nginx, Caddy...)
# BEHIND_PROXY=1
